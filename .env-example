# q20 environment — copy to .env and fill in. Local Ollama needs NO API key.

# Ollama HTTP endpoint (overrides config/models.json:ollama_base_url if set).
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Google (Gmail/Calendar) report delivery — only needed for the `google` extra.
# Path to an OAuth client secrets file and a cached token (see secrets/).
GOOGLE_CLIENT_SECRETS=secrets/credentials.json
GOOGLE_TOKEN=secrets/token.json

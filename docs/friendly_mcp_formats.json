{
  "purpose": "Shared JSON formats for a non-counted friendly P2P match between nis-yar1 and bestteam/Itay.",
  "source_game_json": "C:\\Users\\User\\Downloads\\game.json",
  "compatibility_notes": [
    "The friendly game.json format below follows Itay/bestteam schema_version 1.2.",
    "Do not add or remove fields after both sides compute the game_json_sha256.",
    "nis-yar1 runtime accepts this format even though it omits crypto.dialect and pheromone_min_center_intensity; those are normalized internally to reference defaults.",
    "Both teams should hash the exact same canonical sorted-key JSON before starting.",
    "bestteam does not support receive_control; coordinate readiness and terms in chat."
  ],
  "mcp_endpoint": {
    "transport": "MCP streamable HTTP",
    "path": "/mcp",
    "required_tools": [
      "negotiate",
      "receive_turn",
      "submit_audit"
    ],
    "tool_argument_shapes": {
      "negotiate": {
        "message": {}
      },
      "receive_turn": {
        "message": {}
      },
      "submit_audit": {
        "payload": {}
      },
      "receive_control_optional": {
        "message": {
          "kind": "status",
          "sender": "police",
          "sub_game_number": 1,
          "status": "READY",
          "step_budget": 30.0,
          "payload": {}
        }
      }
    }
  },
  "control_message_schema": {
    "type": "object",
    "required": [
      "kind",
      "sender"
    ],
    "additionalProperties": true,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "enable",
          "status",
          "restart",
          "quit"
        ]
      },
      "sender": {
        "type": "string",
        "enum": [
          "police",
          "thief"
        ]
      },
      "sub_game_number": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "status": {
        "type": [
          "string",
          "null"
        ]
      },
      "step_budget": {
        "type": [
          "number",
          "null"
        ]
      },
      "payload": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
  "recommended_control_messages": {
    "hello": {
      "kind": "status",
      "sender": "police",
      "sub_game_number": 1,
      "status": "HELLO",
      "step_budget": 30.0,
      "payload": {
        "from_group_id": "nis-yar1",
        "to_group_id": "bestteam",
        "mcp_url": "https://<our-public-domain>/mcp",
        "message": "Hello. This is a non-counted friendly coordination ping. Please ACK over receive_control."
      }
    },
    "terms_proposed": {
      "kind": "status",
      "sender": "police",
      "sub_game_number": 1,
      "status": "TERMS_PROPOSED",
      "step_budget": 30.0,
      "payload": {
        "from_group_id": "nis-yar1",
        "to_group_id": "bestteam",
        "mode": "friendly",
        "game_json_schema_version": "1.2",
        "game_json_sha256": "<sha256-of-exact-agreed-game-json>",
        "scent_dialect": "multiplicative_book_v1",
        "our_starting_role_for_odd_subgames": "thief",
        "our_commit_sha": "<40-char-git-sha>",
        "opponent_expected_sha": "<40-char-git-sha-or-null>",
        "our_public_mcp_url": "https://<our-public-domain>/mcp",
        "friendly_email_recipients": [
          "yardentziar@gmail.com",
          "<bestteam-email>"
        ],
        "counted": false,
        "lecturer_email_allowed": false
      }
    },
    "terms_ack": {
      "kind": "status",
      "sender": "thief",
      "sub_game_number": 1,
      "status": "TERMS_ACK",
      "step_budget": 30.0,
      "payload": {
        "from_group_id": "bestteam",
        "to_group_id": "nis-yar1",
        "mode": "friendly",
        "game_json_schema_version": "1.2",
        "game_json_sha256": "<same-sha256>",
        "scent_dialect": "multiplicative_book_v1",
        "opponent_public_mcp_url": "https://<bestteam-public-domain>/mcp",
        "opponent_commit_sha": "<40-char-git-sha>",
        "ready_to_start": true
      }
    }
  },
  "friendly_game_json_template": {
    "agreed_between": [
      "bestteam",
      "nis-yar1"
    ],
    "board_and_agents": {
